# --- Terraform ---------------------------------------------------------------
# Provider binaries and module caches. Hundreds of MB, machine-specific,
# regenerated by `terraform init`.
.terraform/
.terraform.tfstate.lock.info

# State. Should never be in git even for a demo: state files contain resource
# attributes, and in a real deployment that includes secrets in plain text.
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Real variable values. The committed terraform.tfvars.example is the template.
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Saved plans — binary, environment-specific, and they can contain secrets too.
tfplan
*.tfplan

# NOTE: .terraform.lock.hcl is deliberately NOT ignored.
# The lock file pins provider versions and their checksums, so it must be
# committed — it is what makes `terraform init` reproducible across machines
# and in CI. Ignoring it is a common mistake and it silently reintroduces the
# "works on my laptop" problem this module exists to avoid.

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Runtime state written by log_analyzer.py
*.checkpoint.json
checkpoint.json

# --- Editors / OS ------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
